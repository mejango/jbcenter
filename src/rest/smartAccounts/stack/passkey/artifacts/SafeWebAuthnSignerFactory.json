      "devdoc": {
        "custom:security-contact": "bounty@safe.global",
        "details": "A factory contract for creating WebAuthn signers. Additionally, the factory supports signature verification without deploying a signer proxies.",
        "events": {
          "Created(address,uint256,uint256,uint176)": {
            "params": {
              "signer": "The signer address.",
              "verifiers": "The P-256 verifiers to use.",
              "x": "The x-coordinate of the public key.",
              "y": "The y-coordinate of the public key."
            }
          }
        },
        "kind": "dev",
        "methods": {
          "constructor": {
            "details": "The {SafeWebAuthnSignerSingleton} singleton implementation is created with as part of this constructor. This ensures that the singleton contract is known, and lets us make certain assumptions about how it works."
          },
          "createSigner(uint256,uint256,uint176)": {
            "details": "The unique signer address must be unique for some given data. This must not revert if the unique owner already exists.",
            "params": {
              "verifiers": "The P-256 verifiers to use.",
              "x": "The x-coordinate of the public key.",
              "y": "The y-coordinate of the public key."
            },
            "returns": {
              "signer": "The signer address."
            }
          },
          "getSigner(uint256,uint256,uint176)": {
            "details": "The unique signer address must be unique for some given data. The signer is not guaranteed to be created yet.",
            "params": {
              "verifiers": "The P-256 verifiers to use.",
              "x": "The x-coordinate of the public key.",
              "y": "The y-coordinate of the public key."
            },
            "returns": {
              "signer": "The signer address."
            }
          },
          "isValidSignatureForSigner(bytes32,bytes,uint256,uint256,uint176)": {
            "details": "This must be equivalent to first deploying the signer with the factory, and then verifying the signature with it directly: `factory.createSigner(signerData).isValidSignature(message, signature)`",
            "params": {
              "message": "The signed message.",
              "signature": "The signature bytes.",
              "verifiers": "The P-256 verifiers to use.",
              "x": "The x-coordinate of the public key.",
              "y": "The y-coordinate of the public key."
            },
            "returns": {
              "magicValue": "Returns the ERC-1271 magic value when the signature is valid. Reverting or returning any other value implies an invalid signature."
            }
          }
        },
        "title": "Safe WebAuthn Signer Factory",
        "version": 1
      },
      "userdoc": {
        "events": {
          "Created(address,uint256,uint256,uint176)": {
            "notice": "Emitted when a new signer is created."
          }
        },
        "kind": "user",
        "methods": {
          "SINGLETON()": {
            "notice": "The {SafeWebAuthnSignerSingleton} implementation to that is used for signature verification by this contract and any proxies it deploys."
          },
          "constructor": {
            "notice": "Creates a new WebAuthn Safe signer factory contract."
          },
          "createSigner(uint256,uint256,uint176)": {
            "notice": "Create a new unique signer for the specified data."
          },
          "getSigner(uint256,uint256,uint176)": {
            "notice": "Gets the unique signer address for the specified data."
          },
          "isValidSignatureForSigner(bytes32,bytes,uint256,uint256,uint176)": {
            "notice": "Verifies a signature for the specified address without deploying it."
          }
        },
        "version": 1
      }
    },
