# Standalone package defaults. Integrated Center uses the parent .env and MCP_-prefixed settings.
# The standalone package never reads the parent workspace's .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000

# Production: PUBLIC_ORIGIN=https://juicebox.center, HOST=0.0.0.0, NODE_ENV=production.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Required in production; keep stable across replicas. Never put real secrets in git.
# PLAN_SECRET=
PLAN_TTL_SECONDS=300
MAX_CONCURRENT_REQUESTS=16

# RPC defaults to JB Center's public read-only RPC. Override individual chains if needed.
JBCENTER_URL=https://juicebox.center
# RPC_URL_1=https://your-provider.example/your-key
# RPC_URL_8453=https://your-provider.example/your-key

# Explicit GraphQL endpoints, including the provider's API-key path if required.
# They are server configuration, never MCP arguments or public output.
# BENDYSTRAW_MAINNET_URL=https://bendystraw.xyz/YOUR_API_KEY/graphql
# BENDYSTRAW_TESTNET_URL=https://testnet.bendystraw.xyz/YOUR_API_KEY/graphql

# Center /v1/search and /v1/intents reads currently require an approved integration origin.
# Set ONLY to an origin approved for this integration by the Center operator.
# JBCENTER_ORIGIN=https://your-approved-integration.example

# Pinning is provided by Center's integrated service, not by these standalone settings.
# Connect to https://juicebox.center/mcp and prepare metadata there before approval/publication.

# Extra accepted Host authorities and browser origins, comma separated.
# Railway health probes need ALLOWED_HOSTS=healthcheck.railway.app.
# ALLOWED_HOSTS=
# ALLOWED_ORIGINS=
