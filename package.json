{
  "name": "jbcenter",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "start": "node dist/src/index.js",
    "build:mcp": "npm --prefix mcp run build",
    "build": "node scripts/rest/clean-build.mjs && npm run build:mcp && npm run build:web && tsc -p tsconfig.build.json && node scripts/rest/copy-assets.mjs",
    "test": "vitest run",
    "load:test": "node scripts/load-test.mjs",
    "typecheck": "npm run build:mcp && tsc --noEmit",
    "check": "node scripts/rest/check-required-tests.mjs",
    "check:preflight": "node scripts/rest/check-required-tests.mjs --preflight",
    "migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate-cli.ts",
    "build:web": "node scripts/rest/build-web.mjs"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.18",
    "@juicebox/mcp": "file:./mcp",
    "busboy": "^1.6.0",
    "hono": "^4.13.8",
    "marked": "18.0.12",
    "multiformats": "^13.4.2",
    "pg": "^8.16.3",
    "undici": "^6.29.1",
    "viem": "^2.37.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/busboy": "^1.5.4",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "4.1.11",
    "zod": "4.6.7"
  }
}
