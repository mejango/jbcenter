{
  "name": "jbcenter",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:mcp && npm run build:web && node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "start": "node dist/src/index.js",
    "build:mcp": "npm --prefix mcp run build",
    "build": "npm run build:mcp && npm run build:web && tsc && node scripts/rest/copy-assets.mjs",
    "test": "vitest run",
    "load:test": "node scripts/load-test.mjs",
    "typecheck": "npm run build:mcp && tsc --noEmit",
    "check": "npm run check:execution && npm --prefix mcp run check && npm run typecheck && npm test && npm run build",
    "check:execution": "node scripts/rest/check-execution.mjs",
    "verify:execution-artifacts": "node src/rest/smartAccounts/stack/verify-artifacts.mjs",
    "migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate-cli.ts",
    "build:web": "node scripts/rest/build-web.mjs",
    "rest": "node scripts/rest/center.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@juicebox/mcp": "file:./mcp",
    "busboy": "^1.6.0",
    "hono": "^4.9.8",
    "multiformats": "^13.4.2",
    "pg": "^8.16.3",
    "viem": "^2.37.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/busboy": "^1.5.4",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "zod": "4.5.4"
  }
}
