{
  "name": "juice-central",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc && node -e \"require('node:fs').cpSync('src/db/migrations','dist/src/db/migrations',{recursive:true})\"",
    "test": "vitest run",
    "load:test": "node scripts/load-test.mjs",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate-cli.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "hono": "^4.9.8",
    "multiformats": "^13.4.2",
    "pg": "^8.16.3",
    "viem": "^2.37.6"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
