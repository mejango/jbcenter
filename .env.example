DATABASE_URL=postgres://postgres:postgres@localhost:5432/jbcenter
JBCENTER_RECONCILER_KEY=replace-with-a-32-character-secret
DWELLIR_API_KEY=replace-with-a-dwellir-api-key
METRICS_TOKEN=replace-with-another-32-character-secret
FILEBASE_ACCESS_KEY_ID=replace-with-a-filebase-s3-access-key
FILEBASE_SECRET_ACCESS_KEY=replace-with-a-filebase-s3-secret-key
FILEBASE_BUCKET=replace-with-a-dedicated-ipfs-bucket
PINATA_JWT=replace-with-a-scoped-pinata-jwt
RATE_LIMIT_PER_MINUTE=600
RPC_REQUEST_LIMIT_PER_MINUTE=600
RPC_SITE_LIMIT_PER_MINUTE=20000
MAX_INTENTS_PER_CLIENT=10000
MAX_STORAGE_BYTES_PER_CLIENT=1073741824
PORT=3000
