DATABASE_URL=postgres://postgres:postgres@localhost:5432/jbcenter
DWELLIR_API_KEY=replace-with-a-dwellir-api-key
# Exact public origin bound into every REST request signature. Defaults to MCP_PUBLIC_ORIGIN.
# REST_PUBLIC_ORIGIN=https://juicebox.center
METRICS_TOKEN=replace-with-another-32-character-secret
FILEBASE_RPC_TOKEN=replace-with-a-bucket-scoped-filebase-rpc-token
PINATA_JWT=replace-with-a-scoped-pinata-jwt
# Optional dedicated directory on persistent storage. Leave unset to only proxy reads.
# IPFS_CACHE_DIR=/data/ipfs
IPFS_CACHE_MAX_BYTES=4294967296
RATE_LIMIT_PER_MINUTE=600
RPC_REQUEST_LIMIT_PER_MINUTE=600
RPC_SITE_LIMIT_PER_MINUTE=20000
MAX_INTENTS_PER_CLIENT=10000
MAX_STORAGE_BYTES_PER_CLIENT=1073741824
PORT=3000

# Integrated V6-only Streamable HTTP endpoint: https://juicebox.center/mcp.
# Required in production; generate a real random secret and keep it stable across replicas.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# MCP_PLAN_SECRET=
MCP_PUBLIC_ORIGIN=https://juicebox.center
MCP_PLAN_TTL_SECONDS=300
MCP_MAX_CONCURRENT_REQUESTS=16
# Configure each network independently with an authorized complete GraphQL URL.
# MCP_BENDYSTRAW_MAINNET_URL=https://bendystraw.xyz/YOUR_API_KEY/graphql
# MCP_BENDYSTRAW_TESTNET_URL=https://testnet.bendystraw.xyz/YOUR_API_KEY/graphql
# Extra accepted hosts/origins; Center's environment browser origins are included automatically.
# MCP_ALLOWED_HOSTS=
# MCP_ALLOWED_ORIGINS=
# MCP_KNOWLEDGE_PATH=

# Hosted passkey wallet. WALLET_ORIGIN mounts the site; the four WALLET_CREATION_* settings together
# enable Base wallet creation from a dedicated treasury key. Never commit a real key.
# WALLET_ORIGIN=https://my.juicebox.center
# Former wallet origins whose hosts redirect to WALLET_ORIGIN (comma-separated).
# WALLET_NETWORKS_PAYER_KEY: private key of the account that funds Relayr bundles deploying the
# account on more chains (Base ETH for Optimism/Arbitrum, Base Sepolia ETH for testnets). Unset
# keeps the "Add more" feature off. Never reuse the creation or recovery keys: their nonces are tracked.
# WALLET_NETWORKS_PAYER_KEY=0x…
# WALLET_LEGACY_ORIGINS=https://wallet.juicebox.center
# WALLET_CREATION_SIGNER_KEY=
# WALLET_CREATION_POOL_ID=
# WALLET_CREATION_ALLOCATION_WEI=
# WALLET_CREATION_INITIAL_NONCE=0
# WALLET_RECOVERY_SIGNER_KEY=
# WALLET_RECOVERY_MAX_OPERATIONS=100
# WALLET_RECOVERY_MAX_COST_WEI=

# Public browser configuration for the same Para sign-in used by Juicebox and Revnet.
# Allow this service origin in the Para dashboard. No Para server secret is used.
# PARA_API_KEY=
PARA_ENVIRONMENT=BETA
# Optional server-authorized application sponsorship. Provider keys remain in REST_ERC4337_CONFIG.
# Each authorizationKey is an independent 32-byte hex secret shared only with that application's backend.
# REST_ERC4337_SPONSOR_ROUTES=[{"id":"beep","chainId":8453,"policyId":"sp_soft_trish_tilby","authorizationKey":"<64 lowercase hex characters>"}]

# Sponsored project-intent deploys (POST /v1/intents/:id/deploy). SPONSOR_SIGNER_KEY funds every
# sponsored chain plus the Relayr payment chain. Absent, the route returns 503. Never reuse the
# wallet creation, recovery or networks-payer keys: their nonces are tracked separately.
# SPONSOR_SIGNER_KEY=
# Set to "1" to pause sponsored deploys without unsetting the signer key.
SPONSOR_PAUSED=0
# Sponsored deploys a single requester may queue per rolling day.
SPONSOR_DEPLOYS_PER_REQUESTER_PER_DAY=5
# Total wei reserved for sponsored deploys per rolling day, across every requester.
SPONSOR_DAILY_BUDGET_WEI=50000000000000000
# Gas ceiling per forwarded deployment call; a prepared request above this is refused.
SPONSOR_MAX_GAS=8000000
# Max fee per gas the sponsor signs when paying for the Relayr bundle.
SPONSOR_MAX_FEE_PER_GAS=1000000000
# Confirmations awaited on each destination chain before a sponsored deploy is recorded.
# The deployment verifier needs two, so a lower value is raised to 2.
SPONSOR_CONFIRMATIONS=2
