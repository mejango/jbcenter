DATABASE_URL=postgres://postgres:postgres@localhost:5432/juice_central
JUICE_CENTRAL_API_KEYS=juicebox-money:replace-with-32-random-characters,revnet-money:replace-with-another-32-random-characters
JUICE_CENTRAL_RECONCILER_KEYS=bendystraw:replace-with-a-third-32-character-secret
JUICE_CENTRAL_CHAINS={"1":{"rpcUrl":"https://example.ethereum.rpc","projectsAddress":"0xREPLACE_WITH_CANONICAL_JBPROJECTS_ADDRESS","confirmations":2,"deploymentVersion":"6"}}
METRICS_TOKEN=replace-with-a-fourth-32-character-secret
FILEBASE_IPFS_RPC_TOKEN=replace-with-a-bucket-specific-filebase-rpc-api-key
PINATA_JWT=replace-with-a-scoped-pinata-jwt
RATE_LIMIT_PER_MINUTE=600
MAX_INTENTS_PER_CLIENT=10000
MAX_STORAGE_BYTES_PER_CLIENT=1073741824
PORT=3000
