DATABASE_URL=postgres://postgres:postgres@localhost:5432/jbcenter
DWELLIR_API_KEY=replace-with-a-dwellir-api-key
# Exact public origin bound into every REST request signature. Defaults to MCP_PUBLIC_ORIGIN.
# REST_PUBLIC_ORIGIN=https://juicebox.center
METRICS_TOKEN=replace-with-another-32-character-secret
FILEBASE_RPC_TOKEN=replace-with-a-bucket-scoped-filebase-rpc-token
PINATA_JWT=replace-with-a-scoped-pinata-jwt
RATE_LIMIT_PER_MINUTE=600
RPC_REQUEST_LIMIT_PER_MINUTE=600
RPC_SITE_LIMIT_PER_MINUTE=20000
MAX_INTENTS_PER_CLIENT=10000
MAX_STORAGE_BYTES_PER_CLIENT=1073741824
PORT=3000

# Integrated V6-only Streamable HTTP endpoint: https://juicebox.center/mcp.
# Required in production; generate a real random secret and keep it stable across replicas.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# MCP_PLAN_SECRET=
MCP_PUBLIC_ORIGIN=https://juicebox.center
MCP_PLAN_TTL_SECONDS=300
MCP_MAX_CONCURRENT_REQUESTS=16
# Configure each network independently with an authorized complete GraphQL URL.
# MCP_BENDYSTRAW_MAINNET_URL=https://bendystraw.xyz/YOUR_API_KEY/graphql
# MCP_BENDYSTRAW_TESTNET_URL=https://testnet.bendystraw.xyz/YOUR_API_KEY/graphql
# Extra accepted hosts/origins; Center's environment browser origins are included automatically.
# MCP_ALLOWED_HOSTS=
# MCP_ALLOWED_ORIGINS=
# MCP_KNOWLEDGE_PATH=
